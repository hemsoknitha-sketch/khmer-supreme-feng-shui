# =====================================================================
# SUPREME FENG SHUI AGI SYSTEM - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Hugging Face Access Token (Required for Core AI Models)
# Obtain from https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_actual_hugging_face_token_here

# 2. Hugging Face Model Endpoints / Repository IDs
# Defaults to official base models or your fine-tuned PEFT/Full models
HF_MODEL_BORAMEY=Qwen/Qwen2.5-7B-Instruct
HF_MODEL_REASONER=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
HF_MODEL_EMBEDDER=BAAI/bge-m3

# 3. Dedicated Inference Endpoints (Optional - if using paid HF dedicated endpoints)
# HF_ENDPOINT_BORAMEY=https://your-custom-endpoint.endpoints.huggingface.cloud
# HF_ENDPOINT_REASONER=https://your-custom-endpoint.endpoints.huggingface.cloud

# 4. Telegram Bot Token (Obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 5. FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# 6. Fallback LLM Provider Keys (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 7. System & Memory Optimization (for 1GB VPS)
MAX_RAM_MB=800
ENABLE_LOCAL_CACHE=true
LOG_LEVEL=INFO
